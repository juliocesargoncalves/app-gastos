// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Exemplo de modelo de usuário
model User {
  id        String      @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  uptetedAt DateTime @default(now())
  deletedAt DateTime @default(now())

  @@map("users")

  transactions Transaction[] 
}

model Transaction {
  id        String      @id @default(uuid())// ID da Transação (identificador único)
  dateTime         DateTime @default(now())              // Data e Hora da transação
  value            Float    // Valor da transação (quanto foi gasto ou recebido)
  category         String   // Categoria (alimentação, transporte, moradia, lazer, etc.)
  transactionType  String   // Tipo de Transação (gasto ou receita)
  description      String   // Descrição (detalhes sobre o que foi comprado/recebido)
  paymentMethod    String   // Método de Pagamento (cartão de crédito, débito, dinheiro, transferência)
  status           String   // Status da Transação (paga, pendente, cancelada)
  paymentForm      String   // Forma de Pagamento (parcela, pagamento único)
  receiptId        String?  // ID do Recibo/Nota Fiscal (opcional)
  userId           String     // ID do usuário (relacionamento com a tabela de usuários)
  
  user             User     @relation(fields: [userId], references: [id]) // Relacionamento com a tabela de usuários
  
  @@map("transaction") // Índice para melhorar a busca por categoria
}

